#!/bin/bash
# Deploy Kubernetes manifests
# Usage: deploy-manifest <manifest-file.yaml> [namespace]

if [ $# -eq 0 ]; then
    echo "Usage: deploy-manifest <manifest-file.yaml> [namespace]"
    echo "Example: deploy-manifest /manifests/coredns.yaml"
    echo "Example: deploy-manifest /manifests/jenkins.yaml jenkins-system"
    exit 1
fi

MANIFEST_FILE="$1"
NAMESPACE="$2"

if [ ! -f "$MANIFEST_FILE" ]; then
    echo "Error: Manifest file '$MANIFEST_FILE' not found"
    exit 1
fi

echo "Deploying $MANIFEST_FILE to k3s-util cluster..."

if [ -n "$NAMESPACE" ]; then
    echo "Using namespace: $NAMESPACE"
    kubectl apply -f "$MANIFEST_FILE" -n "$NAMESPACE"
else
    kubectl apply -f "$MANIFEST_FILE"
fi

echo "Deployment complete!"
