#!/bin/bash
# List ingress rules (hostname → service) for the configured tunnel.
set -e
CONFIG=$(curl -4 -fsS -H "Authorization: Bearer $CF_API_TOKEN" \
    "$CF_API/accounts/$CF_ACCOUNT_ID/cfd_tunnel/$CF_TUNNEL_ID/configurations")

echo "Ingress rules for $CF_TUNNEL_NAME:"
echo "$CONFIG" | jq -r '.result.config.ingress[] |
    if .hostname then
        "  \(.hostname)\(if .path then " (path: \(.path))" else "" end) → \(.service)"
    else
        "  [catch-all] → \(.service)"
    end'
