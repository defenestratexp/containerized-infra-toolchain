#!/bin/bash
# Add (or update) a public hostname → service mapping in the tunnel.
# Usage: cf-tunnel-add-hostname <hostname> <service-url>
#   service-url examples: http://192.0.2.169  http://198.51.100.20:80  https://192.0.2.31:8000
# Idempotent: replaces any existing rule with the same hostname.
set -e

HOSTNAME="$1"
SERVICE="$2"

if [ -z "$HOSTNAME" ] || [ -z "$SERVICE" ]; then
    echo "Usage: cf-tunnel-add-hostname <hostname> <service-url>" >&2
    echo "Example: cf-tunnel-add-hostname alerts.example.com http://192.0.2.169" >&2
    exit 1
fi

# Fetch current config
CFG_URL="$CF_API/accounts/$CF_ACCOUNT_ID/cfd_tunnel/$CF_TUNNEL_ID/configurations"
CURRENT=$(curl -4 -fsS -H "Authorization: Bearer $CF_API_TOKEN" "$CFG_URL")
INGRESS=$(echo "$CURRENT" | jq '.result.config.ingress')
WARP=$(echo "$CURRENT" | jq '.result.config["warp-routing"] // empty')

# Build new ingress: drop any existing rule for this hostname, then insert
# the new one before the catch-all (last rule, which has no hostname).
NEW_INGRESS=$(echo "$INGRESS" | jq \
    --arg h "$HOSTNAME" --arg s "$SERVICE" '
    map(select(.hostname != $h))
    | (length - 1) as $tail
    | .[0:$tail] + [{hostname: $h, service: $s}] + .[$tail:]
')

# Compose body, preserve warp-routing if present
if [ -n "$WARP" ] && [ "$WARP" != "null" ]; then
    BODY=$(jq -n --argjson ingress "$NEW_INGRESS" --argjson warp "$WARP" \
        '{config: {ingress: $ingress, "warp-routing": $warp}}')
else
    BODY=$(jq -n --argjson ingress "$NEW_INGRESS" \
        '{config: {ingress: $ingress}}')
fi

echo "Updating tunnel config to include: $HOSTNAME → $SERVICE"
RESPONSE=$(curl -4 -fsS -X PUT \
    -H "Authorization: Bearer $CF_API_TOKEN" \
    -H "Content-Type: application/json" \
    --data "$BODY" \
    "$CFG_URL")

if echo "$RESPONSE" | jq -e '.success' >/dev/null; then
    echo "OK. New ingress rule list:"
    cf-tunnel-list
else
    echo "FAILED:" >&2
    echo "$RESPONSE" | jq '.errors' >&2
    exit 1
fi
