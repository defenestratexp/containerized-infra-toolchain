#!/usr/bin/env python3
"""
Proxmox Storage Management CLI
"""

import sys
import argparse
import json
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent / 'lib'))

from proxmox_client import get_client
from tabulate import tabulate


def list_storage(args):
    """List storage locations"""
    client = get_client()
    storage = client.get_storage(node=args.node)

    if args.json:
        print(json.dumps(storage, indent=2))
        return

    if not storage:
        print("No storage found")
        return

    headers = ['Storage', 'Type', 'Content', 'Enabled', 'Active']
    rows = []
    for s in sorted(storage, key=lambda x: x.get('storage', '')):
        rows.append([
            s.get('storage', 'N/A'),
            s.get('type', 'N/A'),
            s.get('content', 'N/A'),
            'Yes' if s.get('enabled', 1) else 'No',
            'Yes' if s.get('active', 0) else 'No'
        ])

    print(tabulate(rows, headers=headers, tablefmt='grid'))


def storage_status(args):
    """Get storage status"""
    client = get_client()
    status = client.get_storage_status(args.node, args.storage)

    if args.json:
        print(json.dumps(status, indent=2))
        return

    total = status.get('total', 0)
    used = status.get('used', 0)
    avail = status.get('avail', 0)
    pct = (used / total * 100) if total > 0 else 0

    print(f"Storage: {args.storage}")
    print(f"Total:   {total // (1024**3)} GB")
    print(f"Used:    {used // (1024**3)} GB ({pct:.1f}%)")
    print(f"Avail:   {avail // (1024**3)} GB")


def storage_content(args):
    """List storage content"""
    client = get_client()
    content = client.get_storage_content(args.node, args.storage, content=args.type)

    if args.json:
        print(json.dumps(content, indent=2))
        return

    if not content:
        print("No content found")
        return

    headers = ['Volume', 'Format', 'Size', 'Used']
    rows = []
    for item in sorted(content, key=lambda x: x.get('volid', '')):
        rows.append([
            item.get('volid', 'N/A'),
            item.get('format', 'N/A'),
            f"{item.get('size', 0) // (1024**3)} GB" if item.get('size') else 'N/A',
            f"{item.get('used', 0) // (1024**3)} GB" if item.get('used') else 'N/A'
        ])

    print(tabulate(rows, headers=headers, tablefmt='grid'))


def main():
    parser = argparse.ArgumentParser(description='Proxmox Storage Management')
    parser.add_argument('--json', action='store_true', help='Output in JSON format')
    parser.add_argument('--node', help='Proxmox node name')

    subparsers = parser.add_subparsers(dest='command', help='Commands')

    # List storage
    list_parser = subparsers.add_parser('list', aliases=['ls'], help='List storage locations')
    list_parser.set_defaults(func=list_storage)

    # Storage status
    status_parser = subparsers.add_parser('status', help='Get storage status')
    status_parser.add_argument('storage', help='Storage name')
    status_parser.add_argument('--node', required=True, help='Node name')
    status_parser.set_defaults(func=storage_status)

    # Storage content
    content_parser = subparsers.add_parser('content', help='List storage content')
    content_parser.add_argument('storage', help='Storage name')
    content_parser.add_argument('--node', required=True, help='Node name')
    content_parser.add_argument('--type', help='Content type (iso, vztmpl, backup, images)')
    content_parser.set_defaults(func=storage_content)

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(1)

    try:
        args.func(args)
    except KeyboardInterrupt:
        print("\nCancelled", file=sys.stderr)
        sys.exit(130)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
